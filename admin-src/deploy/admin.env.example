# Copy to a root-owned 0600 file outside git; supply values privately.
LOLO_ADMIN_HTTPS_STAGING=true
LOLO_ADMIN_ORIGIN=https://admin.example.test
LOLO_ADMIN_DATABASE_URL=
LOLO_ADMIN_ENCRYPTION_KEY=
LOLO_ADMIN_PROXY_TOKEN=
LOLO_ADMIN_PORT=4180

# Remote admin PostgreSQL must use sslmode=verify-full and a trusted CA.
# Never configure a family, billing or homework database as the admin database.
