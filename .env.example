HOST=127.0.0.1
PORT=4173
PROVIDER_TOKEN_RATE_LIMIT_PER_MINUTE=20
TTS_RATE_LIMIT_PER_MINUTE=8
OPENAI_API_KEY=replace-with-your-own-key
GEMINI_API_KEY=replace-with-your-own-key
GEMINI_BACKUP_API_KEY=replace-with-your-own-key
# Optional: choose an alternate Gemini Live model for the backup key.
GEMINI_BACKUP_MODEL=models/gemini-3.8-live
# Optional: OpenAI Realtime settings.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=shimmer

# Optional process-local safety controls; NOT a distributed billing quota.
LOLO_VOICE_ENABLED=true
LOLO_TTS_ENABLED=true
OPENAI_ENABLED=true
GEMINI_ENABLED=true
GEMINI_BACKUP_ENABLED=true
LOLO_GLOBAL_PAID_REQUESTS_PER_MINUTE=120
LOLO_CLIENT_TTS_REQUESTS_PER_MINUTE=12

# Family identity is disabled by default. Use a dedicated PostgreSQL database.
LOLO_FAMILY_ENABLED=false
# LOLO_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Limited learning sync requires the family service and migration 002. Staging synthetic data only until consent review.
LOLO_PROGRESS_SYNC_ENABLED=false

# Staging-only parent UI. Keep false in production until identity/consent and security review.
LOLO_PARENT_CLOUD_UI_ENABLED=false

# Explicit opt-in for curated public signed content only. No admin credentials.
LOLO_CONTENT_DELIVERY_ENABLED=false
# LOLO_CONTENT_CATALOG_FILE=/private/operator-reviewed/catalog.json

# Shared DB admission guard: migrate dedicated database first, then set required.
LOLO_SHARED_REQUEST_BUDGET=off
# LOLO_BUDGET_DATABASE_URL=postgresql://user:password@host:5432/budget?sslmode=require
LOLO_SHARED_PAID_PER_MINUTE=120
LOLO_SHARED_PAID_PER_DAY=3000
LOLO_SHARED_LOGIN_PER_MINUTE=30

# Opt in only after Neon production schema is verified; never use preview fallback.
LOLO_USE_VERCEL_DATABASE=false
# Separate budget database recommended; explicit consent required to share family DB.
LOLO_BUDGET_USE_FAMILY_DB=false
